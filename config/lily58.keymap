#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>

&soft_off { hold-time-ms = 5000; }; // Only turn off it the key is held for 5 seconds or longer.

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // ------------------------------------------------------------------------------------------------------------
            // |  ESC  |  1  |  2  |  3   |    4     | 5 |                    | 6 | 7 |   8   |  9   |  0   | BKSPC |
            // |  TAB  |  q  |  w  |  e   |    r     | t |                    | y | u |   i   |  o   |  p   |   -   |
            // | SHIFT |  a  |  s  |  d   |    f     | g |                    | h | j |   k   |  l   |  UP  |   '   |
            // |  CTRL | ALT |  z  |  x   |    c     | v |   [   |    |   ;   | b | n |   m   | LEFT | DOWn | RIGHT |
            //                     |  CMD | soft_off | , | SPACE |    | ENTER | . | / | LAYER |

          display-name = "Base";
            bindings = <
&kp ESCAPE  &kp N1        &kp N2  &kp N3    &kp N4     &kp N5                                 &kp N6   &kp N7    &kp N8  &kp N9    &kp N0    &kp BACKSPACE
&kp TAB     &kp Q         &kp W   &kp E     &kp R      &kp T                                  &kp Y    &kp U     &kp I   &kp O     &kp P     &kp MINUS
&kp LSHFT   &kp A         &kp S   &kp D     &kp F      &kp G                                  &kp H    &kp J     &kp K   &kp L     &kp UP    &kp SQT
&kp LCTRL   &kp LEFT_ALT  &kp Z   &kp X     &kp C      &kp V      &kp LBKT     &kp SEMICOLON  &kp B    &kp N     &kp M   &kp LEFT  &kp DOWN  &kp RIGHT
                                  &kp LCMD  &soft_off  &kp COMMA  &kp SPACE    &kp ENTER      &kp DOT  &kp FSLH  &mo 1
            >;
        };

        lower_layer {
            // ------------------------------------------------------------------------------------------------------------
            // |  |  |  |  |  |  |                |  |  |  |  |  |  |
            // |  |  |  |  |  |  |                |  |  |  |  |  |  |
            // |  |  |  |  |  |  |                |  |  |  |  |  |  |
            // |  |  |  |  |  |  |  |          |  |  |  |  |  |  |  |
            //          |  |  |  |  |          |  |  |  |  |

            display-name = "Lower";
            bindings = <
&kp GRAVE     &kp F1  &kp F2   &kp F3   &kp F4  &kp F5                                &trans  &trans          &kp K_MUTE  &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &kp DELETE
&kp CAPSLOCK  &kp F6  &kp F7   &kp F8   &kp F9  &kp F10                               &trans  &bt BT_CLR_ALL  &bt BT_CLR  &bt BT_SEL 0       &bt BT_SEL 1     &kp EQUAL
&trans        &trans  &kp F11  &kp F12  &trans  &trans                                &trans  &trans          &trans      &trans             &trans           &trans
&trans        &trans  &trans   &trans   &trans  &trans   &kp RIGHT_BRACKET    &trans  &trans  &trans          &trans      &trans             &trans           &trans
                               &trans   &trans  &trans   &trans               &trans  &trans  &kp BACKSLASH   &trans
            >;
        };


        raise_layer {
            // ----------------------------------------------------------------------------------------------------------
            // |     |     |     |      |      |      |                   |      |       |       |      |       |       |
            // |     |     |     |      |      |      |                   |      |       |       |      |       |       |
            // |     |     |     |      |      |      |                   |      |       |       |      |       |       |
            // |     |     |     |      |      |      |        |  |       |      |       |       |      |       |       |
            //                   |      |      |      |        |  |       |      |       |       |

            display-name = "Raise";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans
            >;
        };

        extra_1 { status = "reserved"; };

        extra_2 { status = "reserved"; };

        extra_3 { status = "reserved"; };
    };
};