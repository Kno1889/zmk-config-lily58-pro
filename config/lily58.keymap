#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // -----------------------------------------------------------------------------------------------
            // | ESC   | 1 | 2 |  3   |  4  |  5  |                    | 6 | 7 |   8   |   9  |   0  | BKSPC |
            // | TAB   | q | w |  e   |  r  |  t  |                    | y | u |   i   |   o  |   p  |   -   |
            // | CAPS  | a | s |  d   |  f  |  g  |                    | h | j |   k   |   l  |  UP  |   ;   |
            // | SHIFT | z | x |  c   |  v  |  b  |   [   |    |   ]   | n | m |   ,   | LEFT | DOWN | LEFT  |
            //                 | CTRL | ALT | CMD | SPACE |    | ENTER | . | / | LAYER |

          display-name = "Base";
            bindings = <
&kp ESCAPE      &kp N1  &kp N2  &kp N3     &kp N4    &kp N5                                    &kp N6   &kp N7    &kp N8     &kp N9    &kp N0    &kp BACKSPACE
&kp TAB         &kp Q   &kp W   &kp E      &kp R     &kp T                                     &kp Y    &kp U     &kp I      &kp O     &kp P     &kp MINUS
&kp CAPSLOCK    &kp A   &kp S   &kp D      &kp F     &kp G                                     &kp H    &kp J     &kp K      &kp L     &kp UP    &kp SEMI
&kp LEFT_SHIFT  &kp Z   &kp X   &kp C      &kp V     &kp B     &kp LBKT     &kp RIGHT_BRACKET  &kp N    &kp M     &kp COMMA  &kp LEFT  &kp DOWN  &kp RIGHT
                                &kp LCTRL  &kp LALT  &kp LGUI  &kp SPACE    &kp ENTER          &kp DOT  &kp FSLH  &mo 1
            >;
        };

        lower_layer {
            // ------------------------------------------------------------------------------------------------------
            // | ` | F1  | F2  | F3 | F4 | F5  |             |            |        | MUTE | VOL_DOWN | VOL_UP | DEL |
            // |   | F6  | F7  | F8 | F9 | F10 |             |            | BT_0   | BT_1 |   BT_2   |  BT_3  |  =  |
            // |   | F11 | F12 |    |    |     |             | BT_CLR_ALL | BT_CLR |      |          |        |  '  |
            // |   |     |     |    |    |     |  |     |    |            |        |      |          |        |     |
            //                 |    |    |     |  |     |    |            |        |  \   |

            display-name = "Lower";
            bindings = <
&kp GRAVE  &kp F1   &kp F2   &kp F3  &kp F4  &kp F5                     &trans          &trans         &kp K_MUTE    &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &kp DELETE
&trans     &kp F6   &kp F7   &kp F8  &kp F9  &kp F10                    &trans          &bt BT_SEL 0   &bt BT_SEL 1  &bt BT_SEL 2       &bt BT_SEL 3     &kp EQUAL
&trans     &kp F11  &kp F12  &trans  &trans  &trans                     &bt BT_CLR_ALL  &bt BT_CLR     &trans        &trans             &trans           &kp SQT
&trans     &trans   &trans   &trans  &trans  &trans   &trans    &trans  &trans          &trans         &trans        &trans             &trans           &trans
                             &trans  &trans  &trans   &trans    &trans  &trans          &kp BACKSLASH  &trans
            >;
        };


        raise_layer {
            // ----------------------------------------------------------------------------------------------------------
            // |     |     |     |      |      |      |                   |      |       |       |      |       |       |
            // |     |     |     |      |      |      |                   |      |       |       |      |       |       |
            // |     |     |     |      |      |      |                   |      |       |       |      |       |       |
            // |     |     |     |      |      |      |        |  |       |      |       |       |      |       |       |
            //                   |      |      |      |        |  |       |      |       |       |

            display-name = "Raise";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans
            >;
        };

        extra_1 { status = "reserved"; };

        extra_2 { status = "reserved"; };

        extra_3 { status = "reserved"; };
    };
};