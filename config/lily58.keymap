#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>

#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // default 600: higher = faster
#define ZMK_POINTING_DEFAULT_SCRL_VAL 15    // default 10: higher = faster scroll

#include <dt-bindings/zmk/pointing.h>

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
};

&msc {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;  // 1 = linear acceleration
};

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // ---------------------------------------------------------------------------------------------------------
            // |  ESC  |  1  |  2  |  3  |    4    |      5     |                   |  6  |  7  |  8  |   9  |   0  | BKSPC |
            // |  TAB  |  Q  |  W  |  E  |    R    |      T     |                   |  Y  |  U  |  I  |   O  |   P  |   -   |
            // | SHIFT |  A  |  S  |  D  |    F    |      G     |                   |  H  |  J  |  K  |   L  |  UP  | ENTER |
            // | CTRL  | ALT |  Z  |  X  |    C    |      V     |  [  |       |  '  |  B  |  N  |  M  | LEFT | DOWN | RIGHT |
            //                     | CMD | SCRL_UP | PLAY/PAUSE | SPC |       | SPC |  .  |  /  | LYR |

            display-name = "Base";
            bindings = <
&kp ESCAPE      &kp N1        &kp N2  &kp N3        &kp N4           &kp N5                                    &kp N6      &kp N7    &kp N8  &kp N9    &kp N0    &kp BACKSPACE
&kp TAB         &kp Q         &kp W   &kp E         &kp R            &kp T                                     &kp Y       &kp U     &kp I   &kp O     &kp P     &kp MINUS
&kp LEFT_SHIFT  &kp A         &kp S   &kp D         &kp F            &kp G                                     &kp H       &kp J     &kp K   &kp L     &kp UP    &kp ENTER
&kp LCTRL       &kp LEFT_ALT  &kp Z   &kp X         &kp C            &kp V             &kp LBKT     &kp SQT    &kp B       &kp N     &kp M   &kp LEFT  &kp DOWN  &kp RIGHT
                                      &kp LEFT_WIN  &kp K_SCROLL_UP  &kp C_PLAY_PAUSE  &kp SPACE    &kp SPACE  &kp PERIOD  &kp FSLH  &mo 1
            >;
        };

        lower_layer {
            // ---------------------------------------------------------------------------------------------------------
            // |   `  |     |     |     |          |     |                   |     |     | MUTE | VOL_DN | VOL_UP |  DEL  |
            // | CAPS |     |     |     |          |     |                   |     |     | BT_0 |  BT_1  |  BT_2  |   =   |
            // |      |     |     |     |          |     |                   |     |     |      |        | MSE_UP |       |
            // |      |     |     |     |          |     |  ]  |       |  ;  |     |     |      | MSE_LT | MSE_DN | MSE_RT|
            //                    | LYR2 | SCRL_DN |  NEXT   | LCK |       | RCK |  ,  |  \  |      |

            display-name = "Lower";
            bindings = <
&kp GRAVE     &trans  &trans  &trans  &trans            &trans                                      &trans     &trans         &kp K_MUTE    &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &kp DELETE
&kp CAPSLOCK  &trans  &trans  &trans  &trans            &trans                                      &trans     &trans         &bt BT_SEL 0  &bt BT_SEL 1       &bt BT_SEL 2     &kp EQUAL
&trans        &trans  &trans  &trans  &trans            &trans                                      &trans     &trans         &trans        &trans             &mmv MOVE_UP     &trans
&trans        &trans  &trans  &trans  &trans            &trans  &kp RIGHT_BRACKET    &kp SEMICOLON  &trans     &trans         &trans        &mmv MOVE_LEFT     &mmv MOVE_DOWN   &mmv MOVE_RIGHT
                              &mo 2  &kp K_SCROLL_DOWN  &kp C_NEXT  &mkp LCLK            &mkp RCLK      &kp COMMA  &kp BACKSLASH  &trans
            >;
        };

        raise_layer {
            // ---------------------------------------------------------------------------------------------------------
            // |  F1  |  F2 |  F3 |  F4  |  F5  |  F6  |                   |     |     |     |     | BT_CLR | BT_CLR_ALL |
            // |  F7  |  F8 |  F9 | F10  | F11  | F12  |                   |     |     |     |     |        |            |
            // |      |     |     |      |      |      |                   |     |     |     |     |        |            |
            // |      |     |     |      |      |      |     |       |     |     |     |     |     |        |            |
            //                    |      |      | PREV |     |       |     |     |     |     |

            display-name = "Raise";
            bindings = <
&kp F1  &kp F2  &kp F3  &kp F4   &kp F5   &kp F6                     &trans  &trans  &trans  &trans  &bt BT_CLR  &bt BT_CLR_ALL
&kp F7  &kp F8  &kp F9  &kp F10  &kp F11  &kp F12                    &trans  &trans  &trans  &trans  &trans      &trans
&trans  &trans  &trans  &trans   &trans   &trans                     &trans  &trans  &trans  &trans  &trans      &trans
&trans  &trans  &trans  &trans   &trans   &trans   &trans    &trans  &trans  &trans  &trans  &trans  &trans      &trans
                        &trans   &trans   &kp C_PREV   &trans    &trans  &trans  &trans  &trans
            >;
        };


        extra_1 { status = "reserved"; };

        extra_2 { status = "reserved"; };

        extra_3 { status = "reserved"; };
    };
};