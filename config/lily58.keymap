#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // ------------------------------------------------------------------------------------------------------------
            // |  ESC  | 1/! | 2/@ | 3/#   | 4/$   | 5/%   |                   | 6/^ | 7/&   |  8/*  |  9/"(" | 0/")" | BSPC  |
            // | TAB   | q/Q | w/W | e/E   | r/R   | t/T   |                   | y/Y | u/U   |  i/I  |  o/O   | p/P   |  -/_  |
            // | SHIFT | a/A | s/S | d/D   | f/F   | g/G   |                   | h/H | j/J   |  k/K  |  l/L   |  UP   | ENTER |
            // | CTRL  | ALT | z/Z | x/X   | c/C   | v/V   | b/B   |   | :/:   | n/N | m/M   |  //?  |  LEFT  | DOWN  | RIGHT |
            //                     | CMD   | "[/{" | "]/}" | SPACE |   | SPACE | ,/< | ./>   | LOWER |

            display-name = "Base";
            bindings = <
&kp ESCAPE      &kp N1        &kp N2  &kp N3    &kp N4            &kp N5                                     &kp N6     &kp N7      &kp N8     &kp N9    &kp N0        &kp BACKSPACE
&kp TAB         &kp Q         &kp W   &kp E     &kp R             &kp T                                      &kp Y      &kp U       &kp I      &kp O     &kp P         &kp MINUS
&kp LEFT_SHIFT  &kp A         &kp S   &kp D     &kp F             &kp G                                      &kp H      &kp J       &kp K      &kp L     &kp UP_ARROW  &kp RETURN
&kp LCTRL       &kp LEFT_ALT  &kp Z   &kp X     &kp C             &kp V              &kp B        &kp SEMI   &kp N      &kp M       &kp SLASH  &kp LEFT  &kp DOWN      &kp RIGHT
                                      &kp LCMD  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp SPACE    &kp SPACE  &kp COMMA  &kp PERIOD  &mo 1
            >;
        };

        lower_layer {
            // ------------------------------------------------------------------------------------------------------------
            // | `/~   | F1  | F2  | F3 | F4 | F5  |                   | BTCLR |      | MUTE | VOL_DOWN | VOL_UP | DEL |
            // | CAPS  | F6  | F7  | F8 | F9 | F10 |                   | BT_0  | BT_1 | BT_2 |          |        | =/+ |
            // |       | F11 | F12 |    |    |     |                   |       |      |      |          |        |     |
            // |       |     |     |    |    |     |  |          | '/" |       |      | \/|  |          |        |     |
            //                     |    |    |     |  |          |     |       |      |      |

            display-name = "Lower";
            bindings = <
&kp GRAVE     &kp F1   &kp F2   &kp F3  &kp F4  &kp F5                              &bt BT_CLR_ALL  &trans        &kp K_MUTE     &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &kp DELETE
&kp CAPSLOCK  &kp F6   &kp F7   &kp F8  &kp F9  &kp F10                             &bt BT_SEL 0    &bt BT_SEL 1  &bt BT_SEL 2   &trans             &trans           &kp EQUAL
&trans        &kp F11  &kp F12  &trans  &trans  &trans                              &trans          &trans        &trans         &trans             &trans           &trans
&trans        &trans   &trans   &trans  &trans  &trans   &trans    &kp SINGLE_QUOTE &trans          &trans        &kp BACKSLASH  &trans             &trans           &trans
                                &trans  &trans  &trans   &trans    &trans           &trans          &trans        &trans
            >;
        };

        raise_layer {
            // ----------------------------------------------------------------------------------------------------------
            // |     |     |     |      |      |      |                   |      |       |       |      |       |       |
            // |     |     |     |      |      |      |                   |      |       |       |      |       |       |
            // |     |     |     |      |      |      |                   |      |       |       |      |       |       |
            // |     |     |     |      |      |      |        |  |       |      |       |       |      |       |       |
            //                   |      |      |      |        |  |       |      |       |       |

            display-name = "Raise";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans
            >;
        };

        extra_1 { status = "reserved"; };

        extra_2 { status = "reserved"; };

        extra_3 { status = "reserved"; };
    };
};