#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // ------------------------------------------------------------------------------------------------------------
            // | ESC   | 1/!   | 2/@ | 3/#   | 4/$   | 5/% |                   | 6/^ | 7/&   |  8/*  |  9/"(" | 0/")" | BSPC  |
            // | TAB   | q/Q   | w/W | e/E   | r/R   | t/T |                   | y/Y | u/U   |  i/I  |  o/O   | p/P   |  -/_  |
            // | SHIFT | a/A   | s/S | d/D   | f/F   | g/G |                   | h/H | j/J   |  k/K  |  l/L   |  UP   |  '/"  |
            // | CTRL  | ALT   | z/Z | x/X   | c/C   | v/V |       |   |  g/G  | b/B | n/N   |  m/M  |  LEFT  | DOWN  | RIGHT |
            //                       | CMD   | "[/{" | ;/: | SPACE |   | ENTER | ./> | //?   | LOWER |

            display-name = "Base";
            bindings = <
&kp ESCAPE &kp N1        &kp N2  &kp N3    &kp N4    &kp N5                             &kp N6   &kp N7    &kp N8  &kp N9    &kp N0    &kp BACKSPACE
&kp TAB    &kp Q         &kp W   &kp E     &kp R     &kp T                              &kp Y    &kp U     &kp I   &kp O     &kp P     &kp MINUS
&kp LSHFT  &kp A         &kp S   &kp D     &kp F     &kp G                              &kp H    &kp J     &kp K   &kp L     &kp UP    &kp SQT
&kp LCTRL  &kp LEFT_ALT  &kp Z   &kp X     &kp C     &kp V      &kp LBKT     &kp RBKT   &kp B    &kp N     &kp M   &kp LEFT  &kp DOWN  &kp RIGHT
                                 &kp LCMD  &kp SEMI  &kp COMMA  &kp SPACE    &kp ENTER  &kp DOT  &kp FSLH  &mo 1
            >;
        };

        lower_layer {
            // ------------------------------------------------------------------------------------------------------------
            // | `/~  | F1  | F2  | F3  | F4  | F5  |                   |    |           | MUTE  | VOL_DOWN | VOL_UP | DEL |
            // | CAPS | F6  | F7  | F8  | F9  | F10 |                   |    | BTCLR_ALL | BTCLR |    BT_0  |  BT_1  | =/+ |
            // |      |     | F11 | F12 |     |     |                   |    |           |       |          |        |     |
            // |      |     |     |     |     |     |  |          |     |    |           |       |          |        |     |
            //                    |     |     |     |  |          |     |    |     \/|   |       |

            display-name = "Lower";
            bindings = <
&kp GRAVE    &kp F1  &kp F2   &kp F3   &kp F4  &kp F5                     &trans  &trans          &kp K_MUTE  &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &kp DELETE
&kp CAPSLOCK &kp F6  &kp F7   &kp F8   &kp F9  &kp F10                    &trans  &bt BT_CLR_ALL  &bt BT_CLR  &bt BT_SEL 0       &bt BT_SEL 1     &kp EQUAL
&trans       &trans  &kp F11  &kp F12  &trans  &trans                     &trans  &trans          &trans      &trans             &trans           &trans
&trans       &trans  &trans   &trans   &trans  &trans   &trans    &trans  &trans  &trans          &trans      &trans             &trans           &trans
                              &trans   &trans  &trans   &trans    &trans  &trans  &kp BACKSLASH   &trans
            >;
        };


        raise_layer {
            // ----------------------------------------------------------------------------------------------------------
            // |     |     |     |      |      |      |                   |      |       |       |      |       |       |
            // |     |     |     |      |      |      |                   |      |       |       |      |       |       |
            // |     |     |     |      |      |      |                   |      |       |       |      |       |       |
            // |     |     |     |      |      |      |        |  |       |      |       |       |      |       |       |
            //                   |      |      |      |        |  |       |      |       |       |

            display-name = "Raise";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans
            >;
        };

        extra_1 { status = "reserved"; };

        extra_2 { status = "reserved"; };

        extra_3 { status = "reserved"; };
    };
};