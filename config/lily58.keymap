#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>

#define ZMK_POINTING_DEFAULT_MOVE_VAL 1500  // default 600: higher = faster
#define ZMK_POINTING_DEFAULT_SCRL_VAL 15    // default 10: higher = faster scroll

#include <dt-bindings/zmk/pointing.h>

&mmv {
    time-to-max-speed-ms = <1000>;
    acceleration-exponent = <1>;
};

&msc {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
};

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // ---------------------------------------------------------------------------------------------------------
            // |  ESC  |  1  |  2  |  3  |  4  |  5  |                   |  6  |  7  |  8  |  9  |   0  | BKSPC |
            // |  TAB  |  Q  |  W  |  E  |  R  |  T  |                   |  Y  |  U  |  I  |  O  |   P  |   -   |
            // | SHIFT |  A  |  S  |  D  |  F  |  G  |                   |  H  |  J  |  K  |  L  |  UP  | ENTER |
            // | CTRL  |  Z  |  X  |  C  |  V  |  B  | ENC |       |  ]  |  N  |  M  |  .  | LEFT | DOWN | RIGHT |
            //                     | ALT | CMD | LYR | SPC |       | SPC |  ;  |  /  | LYR |

            display-name = "Base";
            bindings = <
&kp ESCAPE      &kp N1  &kp N2  &kp N3        &kp N4    &kp N5                                   &kp N6         &kp N7    &kp N8      &kp N9    &kp N0    &kp BACKSPACE
&kp TAB         &kp Q   &kp W   &kp E         &kp R     &kp T                                    &kp Y          &kp U     &kp I       &kp O     &kp P     &kp MINUS
&kp LEFT_SHIFT  &kp A   &kp S   &kp D         &kp F     &kp G                                    &kp H          &kp J     &kp K       &kp L     &kp UP    &kp ENTER
&kp LCTRL       &kp Z   &kp X   &kp C         &kp V     &kp B   &kp K_MUTE    &kp RIGHT_BRACKET  &kp N          &kp M     &kp PERIOD  &kp LEFT  &kp DOWN  &kp RIGHT
                                &kp LEFT_ALT  &kp LCMD  &mo 1   &kp SPACE     &kp SPACE          &kp SEMICOLON  &kp FSLH  &mo 1
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };

        lower_layer {
            // ---------------------------------------------------------------------------------------------------------
            // |   `  |  F1 |  F2 |  F3 |    F4    |    F5      |                         |  F6  |  F7  |  F8  |  F9  | F10 |  DEL  |
            // | CAPS | F11 | F12 |     |  BT_CLR  | BT_CLR_ALL |             | BT_CLR_ALL | BT_CLR | BT_0 | BT_1 | BT_2 |   =   |
            // |      |     |     |     |          |            |                         |      |      |      |      | MSE_UP |       |
            // |      |     |     |     |          |            | ENC |       |  [  |      |      |  ,   | MSE_LT | MSE_DN | MSE_RT |
            //                    |     |          |            | LCK |       | RCK |  '   |  \   |      |

            display-name = "Lower";
            bindings = <
&kp GRAVE     &kp F1   &kp F2   &kp F3  &kp F4      &kp F5                                         &kp F6          &kp F7         &kp F8        &kp F9          &kp F10         &kp DELETE
&kp CAPSLOCK  &kp F11  &kp F12  &trans  &bt BT_CLR  &bt BT_CLR_ALL                                 &bt BT_CLR_ALL  &bt BT_CLR     &bt BT_SEL 0  &bt BT_SEL 1    &bt BT_SEL 2    &kp EQUAL
&trans        &trans   &trans   &trans  &trans      &trans                                         &trans          &trans         &trans        &trans          &mmv MOVE_UP    &trans
&trans        &trans   &trans   &trans  &trans      &trans          &trans       &kp LEFT_BRACKET  &trans          &trans         &kp COMMA     &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT
                                &trans  &trans      &trans          &mkp LCLK    &mkp RCLK         &kp SQT         &kp BACKSLASH  &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };

        raise_layer {
            // ---------------------------------------------------------------------------------------------------------
            // |      |     |     |      |      |      |                   |     |     |     |     |        |            |
            // |      |     |     |      |      |      |                   |     |     |     |     |        |            |
            // |      |     |     |      |      |      |                   |     |     |     |     |        |            |
            // |      |     |     |      |      |      |     |       |     |     |     |     |     |        |            |
            //                    |      |      |      |     |       |     |     |     |     |

            display-name = "Raise";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };

        extra_1 { status = "reserved"; };

        extra_2 { status = "reserved"; };

        extra_3 { status = "reserved"; };
    };
};